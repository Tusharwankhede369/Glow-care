NODE_ENV=development
PORT=5000
# IMPORTANT: keep DB name casing consistent on Windows. The local database is
# named "Glowcare", so do not change this to "glowcare".
MONGODB_URI=mongodb://127.0.0.1:27017/Glowcare
JWT_SECRET=replace_me_with_a_strong_secret
# Optional: required to create another admin after the first admin exists.
ADMIN_SETUP_KEY=replace_with_a_private_setup_key
GOOGLE_CLIENT_ID=your_google_web_client_id.apps.googleusercontent.com

# Comma-separated
CLIENT_ORIGINS=http://localhost:3000,http://localhost:5173

# Used to generate clickable links in emails (optional).
# Example:
# APP_BASE_URL=http://localhost:5000

# SMTP (required for email verification + forgot password emails)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=twankhede42@gmail.com
SMTP_PASS=replace_with_your_app_password
MAIL_FROM="Glow Care <twankhede42@gmail.com>"
